diff --git a/src/runner_doiact_functions_stars.h b/src/runner_doiact_functions_stars.h
index 872f6b6c8..8fef8587d 100644
--- a/src/runner_doiact_functions_stars.h
+++ b/src/runner_doiact_functions_stars.h
@@ -1195,17 +1195,20 @@ void DOPAIR1_SUBSET_BRANCH_STARS(struct runner *r,
   const int flipped = runner_flip[sid];
   sid = sortlistID[sid];
 
-  /* Let's first lock the cell */
+  /* Lock the cell. We must keep this lock held for as long as we read the
+     sort array below: this subset interaction is driven from the stars ghost,
+     i.e. *outside* the task graph, so there is no scheduler dependency
+     preventing another runner thread from concurrently (re-)sorting cj. A
+     concurrent runner_do_hydro_sort() -> cell_malloc_hydro_sorts() can
+     swift_free() and swap cj->hydro.sort while we walk it, giving out-of-range
+     sort indices and an out-of-bounds read. Holding extra_sort_lock across the
+     read serialises us against that free/realloc. */
   lock_lock(&cj->hydro.extra_sort_lock);
 
   const int is_sorted =
       (cj->hydro.sorted & (1 << sid)) &&
       (cj->hydro.dx_max_sort_old <= space_maxreldx * cj->dmin);
 
-  /* Unlock if it wasn't sorted as we will not use the sort array */
-  if (lock_unlock(&cj->hydro.extra_sort_lock) != 0)
-    error("Impossible to unlock cell!");
-
 #if defined(SWIFT_USE_NAIVE_INTERACTIONS)
   const int force_naive = 1;
 #else
@@ -1214,9 +1217,17 @@ void DOPAIR1_SUBSET_BRANCH_STARS(struct runner *r,
 
   /* Can we use the sorted interactions or do we default to naive? */
   if (force_naive || !is_sorted) {
+    /* The naive interaction does not touch cj->hydro.sort, so we can release
+       the lock before doing the (potentially long) interaction. */
+    if (lock_unlock(&cj->hydro.extra_sort_lock) != 0)
+      error("Impossible to unlock cell!");
     DOPAIR1_SUBSET_STARS_NAIVE(r, ci, sparts_i, ind, scount, cj, shift);
   } else {
+    /* The sorted interaction reads cj->hydro.sort: keep the lock held across
+       it, then release. */
     DOPAIR1_SUBSET_STARS(r, ci, sparts_i, ind, scount, cj, sid, flipped, shift);
+    if (lock_unlock(&cj->hydro.extra_sort_lock) != 0)
+      error("Impossible to unlock cell!");
   }
 }
 
